{
    "name": "giacomomasseron/filament-async-column",
    "description": "A Filament v5 table column that loads its value asynchronously.",
    "keywords": ["laravel", "filament", "filament-plugin", "table", "async"],
    "license": "MIT",
    "authors": [{ "name": "Giacomo Masseroni", "email": "giacomom@gmail.com" }],
    "require": {
        "php": "^8.2",
        "filament/support": "^5.0",
        "filament/tables": "^5.0",
        "spatie/invade": "^2.1",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": { "psr-4": { "GiacomoMasseroni\\AsyncColumn\\": "src/" } },
    "autoload-dev": { "psr-4": { "GiacomoMasseroni\\AsyncColumn\\Tests\\": "tests/" } },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": ["GiacomoMasseroni\\AsyncColumn\\AsyncColumnServiceProvider"]
        }
    },
    "config": { "allow-plugins": { "pestphp/pest-plugin": true, "phpstan/extension-installer": true } },
    "minimum-stability": "stable",
    "prefer-stable": true
}
